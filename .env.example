# ATLAS — variables d'environnement
#
# Copiez ce fichier en `.env.local` et renseignez les valeurs de votre projet
# Supabase (Paramètres → API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ SERVEUR UNIQUEMENT. Cette clé contourne la RLS : elle donne accès aux
# décisions de toutes les équipes. Ne jamais la préfixer NEXT_PUBLIC_, ne jamais
# l'importer depuis un composant client. Le test `boundaries.test.ts` vérifie
# statiquement qu'elle ne peut pas atteindre un bundle navigateur.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
